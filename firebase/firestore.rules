rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Voca Basic Cloud License Security Rules
    // Toàn bộ client desktop Voca Basic tương tác qua Cloud Functions (Admin SDK).
    // Tuyệt đối chặn truy cập trực tiếp từ client SDK bên ngoài.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
